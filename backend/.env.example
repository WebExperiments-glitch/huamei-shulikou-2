# 术力口周榜 · 后端配置模板
# 用法：把本文件复制为 backend/.env，并填入真实值。.env 不进版本库（项目非 git 仓库，注意不要外泄）。

# ===========================================================================
# 数据源
# ===========================================================================
# 官方 biliboard 数据库（SQLite）路径。默认推算到仓库外同级目录，
# 开源部署时请务必指向实际路径，否则后端无法读取官方榜单数据。
# SOURCE_DB=C:/path/to/biliboard-database/表格写入sqlite/biliboard (11).db

# ===========================================================================
# AI 智能体云端模式（可选）
# ===========================================================================
# 仅当配置了 AI_BASE_URL 才启用「云端模式」（启用后跳过本地 4B/2B 故障转移，直接走 OpenAI 兼容端点）。

# 云端模式开关：填 OpenAI 兼容的 base url 即启用云端
AI_BASE_URL=https://api.deepseek.com/v1

# 云端 API Key
AI_API_KEY=sk-your-key-here

# 云端模型名（DeepSeek-V4-Flash 正式版用 deepseek-v4-flash）
AI_MODEL=deepseek-v4-flash

# 思考链开关（仅云端有效；本地蒸馏模型本就强制思考，无需此项）：true / false
AI_THINKING_ENABLED=true

# 思考力度：none / low / medium / high / xhigh / max
AI_REASONING_EFFORT=high

# 云端单次生成 token 上限（本地模式无效）
AI_CLOUD_MAX_TOKENS=8192

# 生成并发上限（防显存/额度过载）：默认 2，单 GPU 建议 1
# AI_MAX_CONCURRENCY=2

# ---------------------------------------------------------------------------
# 智能体联网搜索配置（可选；不配置则 agent 的 web_search 走 DuckDuckGo 兜底，受限网络下会优雅降级）
# WEB_SEARCH_PROVIDER 取值：tavily / brave / exa / searxng / duckduckgo（默认未配置=duckduckgo 兜底）
# ---------------------------------------------------------------------------
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=  # tavily 时必填
# BRAVE_API_KEY=   # brave 时必填
# EXA_API_KEY=     # exa 时必填
# SEARXNG_URL=http://localhost:8080/search  # searxng（自托管）时填实例地址
#
# 选型参考（2025-2026）：
#   Tavily  —— AI 原生，返回已清洗正文+引用，免费 1000 次/月，最适合 agent（需 key）
#   Brave   —— 独立索引、快、隐私好，约 $5/千次，免费额度有限（需 key）
#   Exa     —— 语义检索、拿得到原文内容，约 $7/千次（需 key）
#   SearXNG —— 自托管聚合引擎，免费无限额，需自己跑一个实例（SEARXNG_URL）
#   DuckDuckGo —— 无 key 兜底，抓 HTML 结果页；受限网络可能被屏蔽
